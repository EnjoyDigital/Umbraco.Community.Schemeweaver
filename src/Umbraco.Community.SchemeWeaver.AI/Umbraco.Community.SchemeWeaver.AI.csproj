<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Umbraco.Community.SchemeWeaver.AI</PackageId>
    <Description>AI-powered schema mapping for SchemeWeaver using Umbraco.AI</Description>
    <PackageTags>umbraco-marketplace schema-org ai</PackageTags>
    <!-- Major-aligned with the rest of the suite (see Directory.Build.props): this
         satellite now ships per-major like every other package in the suite — 17.x
         for Umbraco 17 and 18.x for Umbraco 18, selected via -p:UmbracoMajor — so
         $(SchemeWeaverPackageVersion) resolves to the building leg's version. -->
    <Version>$(SchemeWeaverPackageVersion)</Version>
    <Authors>Oliver Picton</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) Oliver Picton</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>Umbraco.Community.SchemeWeaver.AI</RootNamespace>
    <!--
      Static web assets: the Vite build outputs index.js to the SDK-default
      wwwroot/ folder, which the Razor SDK auto-discovers and propagates
      transitively to referencing projects (e.g. the TestHost). The
      StaticWebAssetBasePath maps that folder to /App_Plugins/SchemeWeaverAI/
      so the umbraco-package.json bundle reference (/App_Plugins/SchemeWeaverAI/index.js)
      resolves — and keeps it distinct from the main package's App_Plugins/SchemeWeaver.
      (Do NOT use a custom folder via a made-up <DefaultWebContentRootPath>; that
      property does not exist in the SDK and the assets are silently never served.)
    -->
    <StaticWebAssetBasePath>App_Plugins/SchemeWeaverAI</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.SchemeWeaver\Umbraco.Community.SchemeWeaver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Depend on the umbrella Umbraco.AI package so installing this satellite brings
         the full AI framework: the backoffice AI section UI (Umbraco.AI.Web.StaticAssets),
         the startup wiring, and persistence (Sqlite/SqlServer) for storing connections
         and profiles. Umbraco.AI.Core alone has none of that, so the section never
         renders and the feature can't be configured. The umbrella pulls NO LLM provider,
         so the satellite stays provider-agnostic — the host installs its own provider
         (e.g. Umbraco.AI.Anthropic). Umbraco.AI.Core is also referenced explicitly
         because the satellite's C# compiles against Umbraco.AI.Core.* directly (it comes
         transitively via the umbrella, but referencing what you compile against is clearer). -->
    <PackageReference Include="Umbraco.AI" Version="$(SchemeWeaverUmbracoAiRange)" />
    <PackageReference Include="Umbraco.AI.Core" Version="$(SchemeWeaverUmbracoAiRange)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude schema files from publish to avoid conflicts with main project -->
    <Content Remove="appsettings-schema.json" />
    <Content Remove="appsettings-schema.Umbraco.Cms.json" />
    <Content Remove="umbraco-package-schema.json" />
    <None Remove="appsettings-schema.json" />
    <None Remove="appsettings-schema.Umbraco.Cms.json" />
    <None Remove="umbraco-package-schema.json" />
  </ItemGroup>

  <!--
    Ensure the satellite frontend JS is built before packing.
    The Vite build outputs to wwwroot/index.js (served as /App_Plugins/SchemeWeaverAI/index.js).
    Set SchemeWeaverAISkipFrontendBuild=true to bypass (e.g. in CI that runs npm build separately).
  -->
  <ItemGroup>
    <_AIFrontendSourceInputs Include="App_Plugins/SchemeWeaverAI/index.ts" />
    <_AIFrontendSourceInputs Include="App_Plugins/SchemeWeaverAI/entity-actions/**/*.ts" />
    <_AIFrontendSourceInputs Include="App_Plugins/SchemeWeaverAI/modals/**/*.ts" />
    <_AIFrontendSourceInputs Include="App_Plugins/SchemeWeaverAI/package.json" />
    <_AIFrontendSourceInputs Include="App_Plugins/SchemeWeaverAI/vite.config.ts" />
    <_AIFrontendDistOutputs Include="wwwroot/index.js" />
    <!-- Note: Vite outDir is relative to vite.config.ts (App_Plugins/SchemeWeaverAI/) → ../../wwwroot/ = this project's wwwroot/ -->
  </ItemGroup>
  <Target Name="EnsureAIFrontendBuiltBeforePack"
          BeforeTargets="Pack"
          Condition="'$(Configuration)' == 'Release' AND '$(SchemeWeaverAISkipFrontendBuild)' != 'true'"
          Inputs="@(_AIFrontendSourceInputs)"
          Outputs="@(_AIFrontendDistOutputs)">
    <Message Text="AI frontend source is newer than wwwroot-ai/ — running 'npm run build' in App_Plugins/SchemeWeaverAI." Importance="high" />
    <Exec Command="npm install" WorkingDirectory="App_Plugins/SchemeWeaverAI" />
    <Exec Command="npm run build" WorkingDirectory="App_Plugins/SchemeWeaverAI" />
    <ItemGroup>
      <_StaleAIStaticAssetsFiles Include="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/staticwebassets.*.json" />
      <_StaleAIStaticAssetsFiles Include="$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/*.dswa.cache.json" />
    </ItemGroup>
    <Delete Files="@(_StaleAIStaticAssetsFiles)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="Configuration=$(Configuration);SchemeWeaverAISkipFrontendBuild=true" />
  </Target>

</Project>
