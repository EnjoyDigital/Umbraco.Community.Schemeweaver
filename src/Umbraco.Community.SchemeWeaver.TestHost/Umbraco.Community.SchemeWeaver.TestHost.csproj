<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <UserSecretsId>95d126b6-eee0-4838-8ec9-afa38a12a91f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions come from the per-major matrix in Directory.Build.props -->
    <PackageReference Include="Umbraco.Cms" Version="$(SchemeWeaverUmbracoCmsHost)" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="$(SchemeWeaverUmbracoCmsHost)" />
    <PackageReference Include="uSync" Version="$(SchemeWeaverUSyncVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.SchemeWeaver\Umbraco.Community.SchemeWeaver.csproj" />
    <ProjectReference Include="..\Umbraco.Community.SchemeWeaver.uSync\Umbraco.Community.SchemeWeaver.uSync.csproj" />
  </ItemGroup>

  <!--
    SchemeWeaver.AI satellite + Anthropic provider: the satellite now ships for BOTH
    majors (Umbraco.AI publishes major-aligned lines, 17.x and 18.x), so the TestHost
    includes it unconditionally. Versions come from the per-major matrix in
    Directory.Build.props (SchemeWeaverUmbracoAi*).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.SchemeWeaver.AI\Umbraco.Community.SchemeWeaver.AI.csproj" />
    <!-- Umbraco.AI.Anthropic pulls Umbraco.AI.Core transtively -->
    <PackageReference Include="Umbraco.AI.Anthropic" Version="$(SchemeWeaverUmbracoAiAnthropicHost)" />
    <!-- Umbrella package: brings AddUmbracoAI() (Startup) AND the backoffice section
         (Umbraco.AI.Web.StaticAssets). Referencing Startup alone is backend-only and
         the AI backoffice section never renders, so connections/profiles can't be set up. -->
    <PackageReference Include="Umbraco.AI" Version="$(SchemeWeaverUmbracoAiHost)" />
  </ItemGroup>

  <!--
    Umbraco Deploy is licensed and OPT-IN for manual/E2E testing only:
      dotnet run -p:SchemeWeaverIncludeDeploy=true
    Keep it off for the default dev loop (no licence banners, no umbraco/Deploy
    folder churn) and NEVER turn it on for test projects — the Deploy.Tests
    project gets Deploy through its own dependency context instead. The flag
    changes the compiled output, so run `dotnet clean` when toggling it (MSBuild
    can silently keep the other variant's DLLs in bin).
    OnPrem boots without a licence: extraction is disabled with a warning, but
    save-time .uda writes and the Settings > Deploy dashboard still work.
  -->
  <ItemGroup Condition="'$(SchemeWeaverIncludeDeploy)' == 'true'">
    <ProjectReference Include="..\Umbraco.Community.SchemeWeaver.Deploy\Umbraco.Community.SchemeWeaver.Deploy.csproj" />
    <PackageReference Include="Umbraco.Deploy.OnPrem" Version="$(SchemeWeaverUmbracoDeployHost)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
