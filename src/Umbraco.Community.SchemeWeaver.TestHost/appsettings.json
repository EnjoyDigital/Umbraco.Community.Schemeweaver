{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "09c5ec10-8a95-4f81-b52f-4ab234b4bdad"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "W1cdoyuLWW9CgGHitSGABfhRKLbt5KHRvNXCnw7RvavrNIVcFhn2aozI7OPaRy+d0ByEjic4CKDOJs7s+9Ri3A=="
      }
    }
  },
  "uSync": {
    "Settings": {
      "RootFolder": "uSync/v18/",
      "ImportOnFirstBoot": true,
      "FirstBootGroup": "All",
      "ExportOnSave": false,
      "ImportAtStartup": "None"
    }
  },
  "SchemeWeaver": {
    "Seo": {
      "_comment": "The TestHost exercises both editions: keep the developer JSON-LD tab next to the SEO Schema tab so the core E2E specs still find it.",
      "HideDeveloperJsonLdTab": false
    }
  }
}
