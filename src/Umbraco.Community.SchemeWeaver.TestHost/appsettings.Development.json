{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "SchemeWeaver TestHost",
        "UnattendedUserEmail": "admin@test.com",
        "UnattendedUserPassword": "SecurePass1234",
        "UnattendedTelemetryLevel": "Detailed"
      },
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": true
      }
    },
    "AI": {
      "Secrets": {
        "_comment": "Supply the Anthropic key via: dotnet user-secrets set \"Umbraco:AI:Secrets:AnthropicApiKey\" \"sk-ant-...\" (run from TestHost dir). In the backoffice Anthropic connection, set ApiKey to the literal: $Umbraco:AI:Secrets:AnthropicApiKey  — NEVER commit a real key here.",
        "AnthropicApiKey": ""
      }
    }
  }
}
