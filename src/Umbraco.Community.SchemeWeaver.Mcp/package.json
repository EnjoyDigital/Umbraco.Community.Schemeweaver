{
  "name": "@umbraco-community/schemeweaver-mcp",
  "version": "1.8.0",
  "type": "module",
  "description": "MCP server for Umbraco.Community.SchemeWeaver \u2014 lets AI assistants browse Schema.org types, inspect Umbraco content types, and create/verify schema mappings",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./collections": "./dist/collections.js",
    "./tool-types": {
      "types": "./dist/tool-types.d.ts"
    }
  },
  "bin": {
    "schemeweaver-mcp": "./dist/index.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup --config tsup.config.ts",
    "postbuild": "umbraco-mcp-generate-types",
    "compile": "tsc --noEmit",
    "watch": "tsup --config tsup.config.ts --watch",
    "generate": "node scripts/extract-openapi.mjs && orval --config orval.config.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=__tests__ --runInBand"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "Umbraco",
    "MCP",
    "Model Context Protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@umbraco-cms/mcp-server-sdk": "17.0.0-beta.28",
    "dotenv": "^18.0.9",
    "uuid": "^14.0.3",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/types": "^30.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/yargs": "^17.0.33",
    "jest": "^30.5.2",
    "msw": "^3.0.3",
    "orval": "^8.45.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "undici": "^8.10.2"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1"
    },
    "@hono/node-server": "^2.0.5"
  },
  "scarf": {
    "enabled": false
  }
}
