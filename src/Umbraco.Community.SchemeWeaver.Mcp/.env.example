# SchemeWeaver MCP Server Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Node.js: Allow self-signed certificates (local Umbraco instances use HTTPS)
# ============================================================================
NODE_TLS_REJECT_UNAUTHORIZED=0

# ============================================================================
# Required: Umbraco Connection Settings
# ============================================================================

# OAuth client credentials of an Umbraco API user
# (Backoffice > Users > API Users > Create)
UMBRACO_CLIENT_ID=your-client-id
UMBRACO_CLIENT_SECRET=your-client-secret

# Base URL of your Umbraco instance
# (the SchemeWeaver TestHost runs on https://localhost:44308)
UMBRACO_BASE_URL=https://localhost:44308

# ============================================================================
# Optional: Delivery API (for the get-rendered-json-ld live-render tool)
# ============================================================================

# SchemeWeaver's live JSON-LD is served by Umbraco's Delivery API, which is OFF
# by default. If you have enabled it and protected it with an API key, set it
# here — it is sent as the `Api-Key` header by get-rendered-json-ld.
# UMBRACO_DELIVERY_API_KEY=your-delivery-api-key

# Self-signed TLS note: get-rendered-json-ld uses a plain fetch against your
# UMBRACO_BASE_URL. For a self-signed localhost host you need
# NODE_TLS_REJECT_UNAUTHORIZED=0 (set above). When this server runs as a Claude
# Code plugin, only the UMBRACO_* vars are forwarded via mcpServers.env, so
# NODE_TLS_REJECT_UNAUTHORIZED is NOT propagated and the live-render fetch may
# fail TLS verification against a self-signed host — same limitation as the
# management-API tools.

# ============================================================================
# Optional: Tool Filtering
# ============================================================================

# Include/exclude specific slices (comma-separated)
# UMBRACO_INCLUDE_SLICES=read,list,search
# UMBRACO_EXCLUDE_SLICES=delete

# Include/exclude specific tools by name (comma-separated)
# UMBRACO_EXCLUDE_TOOLS=delete-schema-mapping,generate-content-type

# Run in read-only mode (disables all write operations)
# UMBRACO_READONLY=true
