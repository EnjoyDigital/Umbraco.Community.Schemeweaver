{
  "name": "schemeweaver-seo-webcomponents",
  "version": "1.0.0",
  "description": "Backoffice section for SchemeWeaver SEO (Umbraco)",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/stamp-cachebust.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-core-bridge.mjs && web-test-runner --config web-test-runner.config.mjs",
    "test:watch": "web-test-runner --config web-test-runner.config.mjs --watch",
    "test:msw": "node scripts/check-core-bridge.mjs && web-test-runner --config web-test-runner.msw.config.mjs",
    "postinstall": "npx msw init . --save",
    "test:mocked-backoffice": "playwright test --config=tests/mocked-backoffice/playwright.config.ts"
  },
  "author": "Enjoy Digital",
  "license": "MIT",
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@umbraco-cms/backoffice": "18.0.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/dev-server-import-maps": "^0.3.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "dompurify": "^3.4.17",
    "msw": "^3.0.3",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vite": "^8.3.5",
    "@playwright/test": "^1.64.1"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.13"
    },
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "^4.3.2"
    }
  },
  "msw": {
    "workerDirectory": [
      ""
    ]
  }
}
