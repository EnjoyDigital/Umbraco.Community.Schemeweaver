<Project>
  <PropertyGroup>
    <!-- Suppress transitive NuGet vulnerability warnings we cannot fix (MimeKit via Umbraco) -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <!--
    ===========================================================================
    Per-major Umbraco build matrix
    ===========================================================================
    A single source tree, two compiled outputs. Umbraco 18 made a binary-breaking
    change (IPublishedContent.Id/Name/... moved down into IPublishedElement), so
    one net10.0 assembly cannot run on both Umbraco 17 and 18. We therefore
    compile per-major, the same way uSync ships 17.x and 18.x from one codebase.

      dotnet build                     -> targets Umbraco 18 (default below)
      dotnet build -p:UmbracoMajor=17  -> targets Umbraco 17

    Everything version-specific is derived from $(UmbracoMajor); no project hard-
    codes an Umbraco version. UMBRACO18 is defined for the 18 build so source can
    branch on the few APIs that genuinely differ (e.g. the navigation extension
    methods' IPublishedStatusFilteringService.Unfiltered, which is 18-only).

    Both majors now ship as STABLE NuGet packages, exactly like uSync: the package
    version's major tracks the Umbraco major (17.x for Umbraco 17, 18.x for Umbraco
    18) and each carries a mutually-exclusive Umbraco.Cms dependency range, so
    `dotnet add package Umbraco.Community.SchemeWeaver` resolves to the build that
    matches the consumer's Umbraco major automatically. $(SchemeWeaverPackageVersion)
    below drives the packed version for each leg.
  -->
  <PropertyGroup>
    <UmbracoMajor Condition="'$(UmbracoMajor)' == ''">18</UmbracoMajor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UmbracoMajor)' == '17'">
    <!-- Consumer-facing dependency range for the shipped package. Floored at 17.4.0: SchemeWeaver
         now consumes the JSON-Schema services (IPropertyEditorSchemaService) that shipped in
         Umbraco 17.4.0, so the type must exist in the referenced/runtime assembly. 17.0-17.3 sites
         should stay on SchemeWeaver 17.8.x. -->
    <SchemeWeaverUmbracoCmsRange>[17.4.0, 18.0.0)</SchemeWeaverUmbracoCmsRange>
    <!-- Pinned version the runnable TestHost installs. 17.5.3 carries the fix for
         the July 2026 Delivery API security advisory. -->
    <SchemeWeaverUmbracoCmsHost>17.5.3</SchemeWeaverUmbracoCmsHost>
    <!-- uSync line for this major (stable) -->
    <SchemeWeaverUSyncVersion>17.3.0</SchemeWeaverUSyncVersion>
    <!-- Umbraco Deploy line for this major: consumer-facing range for the Deploy satellite
         (Deploy majors track CMS majors, so the legs stay mutually exclusive) and the pinned
         version installed for local/manual Deploy testing. -->
    <SchemeWeaverUmbracoDeployRange>[17.0.0, 18.0.0)</SchemeWeaverUmbracoDeployRange>
    <SchemeWeaverUmbracoDeployHost>17.2.1</SchemeWeaverUmbracoDeployHost>
    <!-- Major-aligned stable package version for the Umbraco 17 line. 17.13.0 adds
         changing an existing mapping's Schema.org type (issue #41). -->
    <SchemeWeaverPackageVersion>17.13.0</SchemeWeaverPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UmbracoMajor)' == '18'">
    <!-- Umbraco 18 is GA (18.0.0): consumer range for the shipped package -->
    <SchemeWeaverUmbracoCmsRange>[18.0.0, 19.0.0)</SchemeWeaverUmbracoCmsRange>
    <!-- Pinned version the runnable TestHost installs. 18.0.2 carries the fix for
         the July 2026 Delivery API security advisory. -->
    <SchemeWeaverUmbracoCmsHost>18.0.2</SchemeWeaverUmbracoCmsHost>
    <!-- uSync 18.0.0 is stable -->
    <SchemeWeaverUSyncVersion>18.0.0</SchemeWeaverUSyncVersion>
    <!-- Umbraco Deploy line for this major (see the 17 leg's comment) -->
    <SchemeWeaverUmbracoDeployRange>[18.0.0, 19.0.0)</SchemeWeaverUmbracoDeployRange>
    <SchemeWeaverUmbracoDeployHost>18.0.1</SchemeWeaverUmbracoDeployHost>
    <!-- Major-aligned stable package version for the Umbraco 18 line. Its
         [18.0.0, 19.0.0) Umbraco.Cms range is mutually exclusive with the 17 leg's
         [17.4.0, 18.0.0), so NuGet only ever resolves one of the two per consumer. -->
    <SchemeWeaverPackageVersion>18.8.0</SchemeWeaverPackageVersion>
    <DefineConstants>$(DefineConstants);UMBRACO18</DefineConstants>
  </PropertyGroup>
</Project>
