<!--
  Regenerates eval/cache/schema-types.json: the Schema.org type graph (every type, its
  supertype, and its properties with their declared ranges) that the TypeSafe eval leg reads.

  It serialises SchemeWeaver's OWN SchemaTypeRegistry, so the ranges and property names are
  exactly the ones the runtime uses. The registry only scans the Schema.NET assembly, so this
  needs no Umbraco boot, no TestHost and no database, unlike fetch-context.mjs.

      dotnet run  [project] eval/SchemaTypeDump  [config] Release

  Deliberately NOT listed in Umbraco.Community.SchemeWeaver.slnx: it is a harness tool, not a
  shipped project, so a root `dotnet build` ignores it.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SchemaTypeDump</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Umbraco.Community.SchemeWeaver/Umbraco.Community.SchemeWeaver.csproj" />
  </ItemGroup>
</Project>
